# Copy this file to Quraaa.API/.env for local development.
# Never commit real credentials.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=quraaa;Username=postgres;Password=change-me
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_DURATION_IN_MINUTES=60

# Required outside Development so OTPs survive restarts and work across instances.
# ConnectionStrings__Redis=localhost:6379
Otp__AllowInMemoryCacheInProduction=false

# Configure only the reverse proxies/networks that actually front the API.
# ForwardedHeaders__KnownProxies__0=127.0.0.1
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/8

# Stripe test-mode credentials.
Stripe__SecretKey=sk_test_replace_me
Stripe__WebhookSecret=whsec_replace_me
Stripe__Currency=usd
Stripe__IsTestMode=true
